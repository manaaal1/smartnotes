{
  "compilerOptions": {
    /* ==== File Structure ==== */
    "rootDir": "./src",
    "outDir": "./dist",

    /* ==== Language & Module Settings ==== */
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["esnext"],
    "types": ["node"],

    /* ==== Build Options ==== */
    "sourceMap": true,
    "declaration": false,         // You don't need .d.ts files for this project
    "skipLibCheck": true,
    "esModuleInterop": true,      // Ensures smooth import of CommonJS modules like express
    "moduleResolution": "node",   // Standard for Node.js projects

    /* ==== Type Checking ==== */
    "strict": true,
    "noImplicitAny": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,

    /* ==== Interop & Imports ==== */
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* ==== Project Cleanliness ==== */
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}

